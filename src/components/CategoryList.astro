---
import { categories } from '../config/categories';
---

<nav class="category-list" aria-label="Categorías">
  {categories.map((category) => (
    <a href={`/products?category=${category.slug}`}>
      {category.name}
    </a>
  ))}
</nav>

<style>
  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
  }

  .category-list a {
    display: inline-block;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    background: #f5f5f5;
    transition: background 0.2s;
  }

  .category-list a:hover {
    background: #e5e5e5;
  }
</style>
