---
import { formatPrice } from '../lib/format';

type Product = {
  id?: string;
  slug?: string;
  title: string;
  price: number;
  image?: string;
};

const { products = [] } = Astro.props as {
  products: Product[];
};
---

<section class="product-list">
  {products.length === 0 ? (
    <p>No hay productos disponibles todavía.</p>
  ) : (
    <div class="product-grid">
      {products.map((product) => (
        <article class="product-card">
          <a href={`/product/${product.slug ?? product.id ?? ''}`}>
            {product.image ? (
              <img
                src={product.image}
                alt={product.title}
                loading="lazy"
              />
            ) : (
              <div class="placeholder">Sin imagen</div>
            )}

            <h3>{product.title}</h3>
            <p>{formatPrice(product.price)}</p>
          </a>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    border: 1px solid #eee;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  .product-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .product-card img,
  .placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background: #f5f5f5;
    color: #777;
  }

  .product-card h3,
  .product-card p {
    margin: 0.75rem 1rem;
  }

  .product-card p {
    font-weight: 700;
  }
</style>
