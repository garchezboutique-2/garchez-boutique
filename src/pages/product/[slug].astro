---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatPrice } from '../../lib/format';
import { categoryName } from '../../config/categories';

export async function getStaticPaths() {
  const products = await getCollection('products');

  return products.map((product) => ({
    params: {
      slug: product.id,
    },
    props: {
      product,
    },
  }));
}

const { product } = Astro.props;
const { data } = product;
---

<Layout>
  <main class="product-detail">
    <a href="/products" class="back">← Volver a productos</a>

    <div class="product-container">
      <div class="product-image">
        {data.image ? (
          <img src={data.image} alt={data.title} />
        ) : (
          <div class="placeholder">Sin imagen</div>
        )}
      </div>

      <div class="product-info">
        <p class="category">{categoryName(data.category)}</p>

        <h1>{data.title}</h1>

        <p class="price">{formatPrice(data.price)}</p>

        <p class="description">{data.description}</p>

        <p class="stock">
          {data.stock > 0
            ? `Disponible: ${data.stock} unidades`
            : 'Agotado'}
        </p>

        {data.stock > 0 && (
          <a
            class="whatsapp"
            href={`https://wa.me/50587961399?text=${encodeURIComponent(
              `Hola, estoy interesada en el producto "${data.title}" de GarChéz Boutique.`
            )}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            💬 Consultar por WhatsApp
          </a>
        )}
      </div>
    </div>
  </main>
</Layout>

<style>
  .product-detail {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    color: #333;
    text-decoration: none;
    font-weight: 600;
  }

  .product-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .product-image {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .product-image img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    color: #777;
  }

  .category {
    color: #777;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }

  .price {
    font-size: 1.7rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .description {
    line-height: 1.7;
    color: #444;
  }

  .stock {
    margin: 1.5rem 0;
    font-weight: 600;
  }

  .whatsapp {
    display: inline-block;
    padding: 0.9rem 1.4rem;
    border-radius: 10px;
    background: #222;
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .product-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
